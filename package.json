{
  "name": "KURIO-ADS",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/fonts": "4.0.547",
    "@remotion/media": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.547",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "a:stills": "node tools/render-ad.mjs KURIO-AD-A-MOON-JAR out/FINAL/INTERNAL_REVIEW/A-moon-jar KURIO_AD_A_MOON_JAR_FINAL --thumbnail=KURIO_AD_A_MOON_JAR_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --stills-only",
    "a:render": "node tools/render-ad.mjs KURIO-AD-A-MOON-JAR out/FINAL/INTERNAL_REVIEW/A-moon-jar KURIO_AD_A_MOON_JAR_FINAL --thumbnail=KURIO_AD_A_MOON_JAR_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --quality=master --audio=shared --silent-master",
    "a:keyframes": "node tools/render-ad.mjs KURIO-AD-A-MOON-JAR out/A-moon-jar-v4 KURIO_AD_A_MOON_JAR_v4 --stills-only --keyframes --thumbnail=KURIO_AD_A_THUMBNAIL_v4.png",
    "a:watch": "node tools/watch-clips.mjs KURIO-AD-A-MOON-JAR a-moon-jar out/A-moon-jar-v5 KURIO_AD_A_MOON_JAR_v5",
    "b:stills": "node tools/render-ad.mjs KURIO-AD-B-TRADITIONAL-GAT out/FINAL/INTERNAL_REVIEW/B-traditional-gat KURIO_AD_B_TRADITIONAL_GAT_FINAL --thumbnail=KURIO_AD_B_TRADITIONAL_GAT_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --stills-only",
    "b:render": "node tools/render-ad.mjs KURIO-AD-B-TRADITIONAL-GAT out/FINAL/INTERNAL_REVIEW/B-traditional-gat KURIO_AD_B_TRADITIONAL_GAT_FINAL --thumbnail=KURIO_AD_B_TRADITIONAL_GAT_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --quality=master --audio=shared --silent-master",
    "c:stills": "node tools/render-ad.mjs KURIO-AD-C-GOTAE-GAT out/FINAL/INTERNAL_REVIEW/C-gotae-gat KURIO_AD_C_GOTAE_GAT_FINAL --thumbnail=KURIO_AD_C_GOTAE_GAT_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --stills-only",
    "c:render": "node tools/render-ad.mjs KURIO-AD-C-GOTAE-GAT out/FINAL/INTERNAL_REVIEW/C-gotae-gat KURIO_AD_C_GOTAE_GAT_FINAL --thumbnail=KURIO_AD_C_GOTAE_GAT_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --quality=master --audio=shared --silent-master",
    "d:stills": "node tools/render-ad.mjs KURIO-AD-D-TIGER-MAGPIE out/FINAL/INTERNAL_REVIEW/D-tiger-magpie KURIO_AD_D_TIGER_MAGPIE_FINAL --thumbnail=KURIO_AD_D_TIGER_MAGPIE_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --stills-only",
    "d:render": "node tools/render-ad.mjs KURIO-AD-D-TIGER-MAGPIE out/FINAL/INTERNAL_REVIEW/D-tiger-magpie KURIO_AD_D_TIGER_MAGPIE_FINAL --thumbnail=KURIO_AD_D_TIGER_MAGPIE_FINAL_THUMBNAIL.png --endcard=KURIO-EndCard-v5 --endcard-version=v5 --quality=master --audio=shared --silent-master",
    "render:all": "npm run a:render && npm run b:render && npm run c:render && npm run d:render",
    "stills:all": "npm run a:stills && npm run b:stills && npm run c:stills && npm run d:stills",
    "composite:d": "node tools/composite/d-plate.mjs",
    "sheet:all": "node tools/compare-all.mjs",
    "sound": "node tools/compose-sound.mjs",
    "sound:apply": "node tools/apply-sound.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
